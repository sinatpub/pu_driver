{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "dev | main",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "args": ["--enable-impeller", "--dart-define-from-file=dart_defines.json"]
    },
    {
      "name": "dev | main (release)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "flutterMode": "release",
      "args": [
        "--no-enable-impeller",
        "--dart-define-from-file=dart_defines.json",
        "--dart-define=DEBUG_LOGIN_IN_RELEASE=true"
      ]
    },
    {
      "name": "dev | apk",
      "type": "node-terminal",
      "request": "launch",
      "command": "fvm flutter build apk --dart-define-from-file=dart_defines.json"
    },
    {
      "name": "dev | mock",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "args": [
        "--enable-impeller",
        "--dart-define-from-file=dart_defines.json",
        "--dart-define=USE_MOCK_DATA=true"
      ]
    },
    {
      "name": "dev | ios",
      "type": "node-terminal",
      "request": "launch",
      "command": "fvm flutter build ios --dart-define-from-file=dart_defines.json"
    },
    {
      "name": "dev | ipa",
      "type": "node-terminal",
      "request": "launch",
      "command": "fvm flutter build ipa --dart-define-from-file=dart_defines.json"
    },
    {
      "name": "dev | release",
      "type": "node-terminal",
      "request": "launch",
      "command": "fvm flutter build ipa --dart-define-from-file=dart_defines.json & fvm flutter build apk --dart-define-from-file=dart_defines.json"
    },
    {
      "name": "dev | firebase | config",
      "type": "node-terminal",
      "request": "launch",
      "command": "flutterfire config --project=taarraa-passenger --out=lib/firebase_options.dart --ios-bundle-id=com.tara.driver.application --android-package-name=com.tara.driver_application"
    },
    {
      "name": "prd | main",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "args": ["--no-enable-impeller", "--dart-define-from-file=dart_defines.json"]
    },
    {
      "name": "prd | appbundle",
      "type": "node-terminal",
      "request": "launch",
      "command": "fvm flutter build appbundle --dart-define-from-file=dart_defines.json"
    },
    {
      "name": "prd | release",
      "type": "node-terminal",
      "request": "launch",
      "command": "fvm flutter build ipa --dart-define-from-file=dart_defines.json & fvm flutter build appbundle --dart-define-from-file=dart_defines.json"
    },
    {
      "name": "clean",
      "type": "node-terminal",
      "request": "launch",
      "command": "fvm flutter clean"
    },
    {
      "name": "when flutterfire not found",
      "type": "node-terminal",
      "request": "launch",
      "command": "dart pub global activate flutterfire_cli"
    }
  ]
}
